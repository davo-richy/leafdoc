# Local development only. Copy to .env and fill in – never commit the real key.
# On Vercel add these under Project Settings → Environment Variables.
# Server-side only: this file is read by api/*.js and lib/*.js. Never import it
# from app.js or any other browser code, and never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash. Older aliases such as gemini-flash-latest
# can return 404 for new API keys.
# GEMINI_MODEL=gemini-3.8-flash
